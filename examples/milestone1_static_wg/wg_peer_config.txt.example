# Example WireGuard peer configuration matching tinylink M1.
#
# This is the *peer* (server) side, not the device side. It pairs with the
# values you provision into NVS via tools/nvs_provision.py.
#
# Replace every REPLACE_WITH_… token before using.

[Interface]
PrivateKey = REPLACE_WITH_PEER_SERVER_PRIVATE_KEY_BASE64
Address    = REPLACE_WITH_PEER_TAILSCALE_IP/32
ListenPort = 51820

[Peer]
# tinylink device
PublicKey           = REPLACE_WITH_DEVICE_PUBLIC_KEY_BASE64
AllowedIPs          = REPLACE_WITH_DEVICE_TAILSCALE_IP/32
PersistentKeepalive = 25
