# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Bryam (bryamzxz)
#
# tinylink default sdkconfig — common to all ESP32 variants.
# Per-target overrides live in sdkconfig.defaults.<target>.
#
# Hardening + tuning baseline for ESP-IDF v5.5.x.

# ---- Target / flash / partition table ----------------------------------------
# partitions.csv places ota_1 at 0x1A0000 and the 0x4000 nvs_creds region at
# 0x320000 (end 0x324000), so flash must be ≥ 4 MB (ESP32-WROOM-32E and
# friends ship with 4 MB).
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
# QIO@80MHz is within the WROOM-32E datasheet Table 17 spec
# ("FC Maximum clock frequency = 80 MHz, guaranteed through design
# and/or characterization") — the integrated flash + module layout
# are pre-characterized by Espressif for this configuration, so no
# soak test is required for this specific module.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ---- WiFi tuning (single-STA, low memory) ------------------------------------
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_NVS_ENABLED=y
# WiFi mgmt buffer pool — IDF default is 32, sized for clients that
# scan + roam across multiple APs (each scan response/beacon/probe
# response burst needs a free buffer). Tinylink associates to ONE
# fixed AP (INTELCOM-CARDONA), never roams, doesn't scan post-assoc.
# 8 buffers cover the worst-case probe-response burst during the
# initial scan + leave headroom for unsolicited beacons / deauth
# frames the supplicant still has to process. ~700 B per buffer,
# 32 -> 8 saves ~16-17 KiB DRAM static. Failure mode if too small:
# WiFi disconnect-retry loop visible immediately in serial logs.
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
# Station-only build: tinylink never runs as an AP (no WIFI_MODE_AP,
# no esp_wifi_set_mode(WIFI_MODE_AP), no softap_start call site).
# Drops the entire AP-side code path: beacon scheduler, AID table,
# DTIM management on AP side, AP-side WPS handshake, AP-side WPA
# supplicant fragment.
# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set
# WPA2-Enterprise (EAP) is not used — the sensor joins a WPA2-PSK AP
# (app_wifi.c sets WIFI_AUTH_WPA2_PSK). Dropping it removes the EAP
# state machines from wpa_supplicant (~20 KiB flash). 2026-09.
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# WPA3-Personal (SAE) handshake codepath: not needed; the production
# AP (INTELCOM-CARDONA) is WPA2-PSK-SHA256 + PMF, not WPA3-Personal.
# Removes SAE-PWE Dragonfly + SAE-H2E variants.
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# WPA3-OWE-STA (Opportunistic Wireless Encryption for open networks).
# tinylink never associates to open APs; the production AP is WPA2.
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set

# ---- Power management --------------------------------------------------------
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# main.c::configure_pm() (called AFTER WiFi associates) sets
# light_sleep_enable=true, max=240, min=80. That call is what unlocks
# PM_MODE_LIGHT_SLEEP in pm_impl.c:561 — without it, tickless idle never
# enters light sleep at all.
#
# ESP_WIFI_SLP_IRAM_OPT and ESP_WIFI_SLP_BEACON_LOST_OPT are documented
# as the "always-on station" pair, but with WPA2-PSK + PMF on
# INTELCOM-CARDONA they break initial association — the AP kicks the
# client between AUTH-ASSOC handshake and DHCP. Verified empirically:
# enabling SLP_IRAM_OPT alone (which auto-selects PM_SLP_DEFAULT_PARAMS_OPT)
# is enough to reproduce the disconnect-retry-loop seen in the previous
# perf round. Stay disabled until we have an A/B against a less PMF-strict
# AP, or until IDF documents the actual interaction.
#
# Boot runs with WIFI_PS_NONE and switches to MIN_MODEM once the WG
# session is up, at the latest 60 s after Wi-Fi start (round 1.3.1,
# app_wifi.c power-save timer): DHCP, DNS, two TLS handshakes, register,
# netmap and the WG handshake each wait a DTIM interval per inbound
# burst under modem sleep. While the modem is awake esp_wifi holds its
# APB_FREQ_MAX PM lock, so light sleep cannot start mid-association.
#
# Errata RTC-126 (RTC register reads after a light-sleep wake with
# RTC_PERIPH powered down) is already covered: IDF's hidden
# CONFIG_ESP_SLEEP_RTC_BUS_ISO_WORKAROUND (y on ESP32) keeps RTC_PERIPH
# powered in every light sleep (sleep_modes.c:2895).

# ---- Brown-out detector (round 1.3.1) ---------------------------------------
# Level 6 (2.77 V ±0.05) instead of IDF's level 0 (2.43 V). The module's
# flash needs ≥ 2.7 V (WROOM-32E Table 17 p.30) and the module itself is
# specified from 3.0 V; resetting below that beats running with a brown
# flash (NVS writes!). Level 6 is the lowest whose whole tolerance band
# (2.72–2.82 V) stays above the flash minimum — level 5 (2.70 V) can trip
# as low as 2.65 V — and keeps 30 mV more headroom than level 7 (2.80 V)
# against nuisance trips on TX peaks. IDF's XMC brown-out flash reset
# keys on vendor 0x20 and this module's flash reads 0x46
# (docs/esp32/README.md), so the detector level is the only guard. The
# app sets the level at startup (the bootloader never touches it), so
# an app-only flash applies it. A BOD reset shows as "reset: brown-out"
# in the boot log and as reset_reason 9 in /stats.
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_6=y

# ---- mbedTLS minimal config (TLS + crypto for ts2021/DERP) -------------------
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_HARDWARE_MPI=y
# No ChaCha20 / Poly1305 in mbedTLS (round 1.3.2). The ts2021 Noise
# records and the DISCO / DERP NaCl box run on the in-tree IRAM
# ChaCha20-Poly1305 / Poly1305 the WireGuard data plane uses
# (components/tinylink/src/crypto/), byte-identical to the mbedTLS path
# (tools/test: test_noise_ik + `make mbedtls-ref`). Side effect on TLS:
# mbedTLS lists the ChaCha20 suites FIRST in its ClientHello, and Go's
# crypto/tls then picks ECDHE-ECDSA-CHACHA20-POLY1305 (client "prefers"
# ChaCha) — so before 1.3.2 the TLS records were software ChaCha20-
# Poly1305, not AES-GCM. Without them the offer starts with
# AES-256-GCM and controlplane + DERP answer ECDHE-ECDSA-AES128-GCM-
# SHA256 (openssl s_client with both offer orders, 2026-10-28): AES on
# the HW accelerator + GHASH in software (MBEDTLS_GCM_C stays).
# CONFIG_MBEDTLS_CHACHA20_C is not set
# CONFIG_MBEDTLS_CHACHAPOLY_C is not set
CONFIG_MBEDTLS_HKDF_C=y
# Heap budget for two simultaneous TLS conns (long-poll + DERP
# supervisor). Pinning rationale, item-by-item:
#
# 1. DYNAMIC_BUFFER=y + SESSION_TICKETS=n. Verified on-device 2026-05-06.
#
# History: PR #20 (512f772) experimented with DYNAMIC_BUFFER=y and a
# 2026-05-02 incident reported mid-write heap corruption, after which
# the flag was reverted. The followup notes attributed it ambiguously
# to either DYNAMIC_BUFFER itself or the (DYNAMIC_BUFFER + tickets)
# combination plus IDF bug PR #14614 / IDFGH-13752 (heap corruption
# when DYNAMIC_BUFFER + IN_CONTENT_LEN<16384) and #15984 (TLS 1.3
# panics with DYNAMIC_BUFFER on).
#
# This sprint isolated the variables: DYNAMIC_BUFFER=y with
# SESSION_TICKETS=n through 5+ minutes of steady-state long-poll
# (full handshake on every reconnect, no ticket resumption) plus
# 70+ telemetry tx in a row, zero corruption, zero alloc fails,
# zero stream ends. IN_CONTENT_LEN stays at 16384 so #14614 does
# not apply. #15984 was historically a TLS 1.3 panic on connect; it
# cannot fire here: MBEDTLS_SSL_PROTO_TLS1_3 is not compiled in, every
# conn negotiates TLS 1.2 (ECDHE-ECDSA-AES128-GCM-SHA256 with X25519
# against the Tailscale fleet since 1.3.2 — ChaCha20-Poly1305 before,
# see the CHACHA lines above; re-checked 2026-10-28).
#
# Heap effect: at supervisor-connect time (post-bringup, post-WG)
# largest_block went from 7.4 KiB → 11.8 KiB (+4.4 KiB). Still
# below the 12 KiB peak mbedtls cert verify needs for the second
# TLS conn, so SUPERVISED=y still doesn't connect on first try
# without further work — that's a separate PR (supervisor task
# restructure to retry until heap allows).
#
# Trade-off vs SESSION_TICKETS=y: each long-poll reconnect now does
# a full TLS handshake (cert chain verify, RSA signature) instead
# of resuming via NewSessionTicket. ~10 KiB transient peak instead
# of ~4 KiB transient peak. Acceptable because the steady-state
# heap budget freed by DYNAMIC_BUFFER=y outweighs the per-reconnect
# cost on this ESP32-WROOM-32E target.
#
# 2. IN_CONTENT_LEN stays at 16384. Go's crypto/tls (what
#    controlplane.tailscale.com runs) emits TLS records up to 16384
#    plaintext regardless of the application layer's frame sizes.
#    Lowering IN below 16384 would surface as record_overflow alerts
#    on a large keepalive or the first MapResponse. Also keeps us
#    out of IDF bug PR #14614 / IDFGH-13752 (heap corruption when
#    DYNAMIC_BUFFER + IN_CONTENT_LEN<16384).
# 3. OUT_CONTENT_LEN at 2048 (down from 4096). tinylink emits short
#    frames in both directions: MapRequest ~500 B-2 KiB, DERP
#    frames <1500 B WG packets. Saves 2 KiB per conn × 2 conns.
# 4. KEEP_PEER_CERTIFICATE off. Saves ~2 KiB per conn; we don't
#    introspect certs after verify.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=n
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
# (A `CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN=4096` line used to sit here; it
# never applied — the option depends on !ASYMMETRIC_CONTENT_LEN, and the
# IN/OUT lengths below are what is in force.)
# TLS renegotiation off (2026-09): neither controlplane nor DERP servers
# renegotiate (Go's TLS stack never initiates it; TLS 1.3 has none), and
# with it enabled mbedtls_ssl_read can itself WRITE on the connection —
# a hazard on the DERP conn, where the supervisor task reads while the
# wg_tx task writes relayed frames through the same SSL context. Also
# drops the renegotiation state machine from the image.
# CONFIG_MBEDTLS_SSL_RENEGOTIATION is not set
# Client-only TLS (2026-09): the firmware never accepts a TLS connection
# (esp_https_server / esp_http_server are excluded in CMakeLists.txt), so
# the server-side handshake state machine is dead weight. Plain-RSA key
# exchange (no forward secrecy; every Tailscale / DERP endpoint negotiates
# ECDHE) and PEM *writing* go with it.
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# CONFIG_MBEDTLS_KEY_EXCHANGE_RSA is not set
# CONFIG_MBEDTLS_PEM_WRITE_C is not set
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# Common-CA bundle (round 1.3.1): the 43 roots of IDF's
# cmn_crt_authorities.csv instead of the full Mozilla list (−51 KB
# flash). Every endpoint this firmware dials chains to ISRG Root X2 /
# X1 (controlplane: leaf → YE1 → Root YE → X2 cross-signed by X1;
# derp*: same via YE2 — openssl s_client 2026-10-28); both are in the
# common set, as are GTS R1–R4, DigiCert, GlobalSign, Amazon and
# USERTrust for a self-hosted control server. A server under a root
# outside that set fails closed at the handshake (X509_CERT_VERIFY_
# FAILED); build with CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# or a custom bundle for it.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# PEM parsing and the extended / compressed EC key forms are unused:
# the bundle is DER, the firmware loads no client key or PEM cert, and
# X.509 certs carry named curves with uncompressed points (round 1.3.1,
# −4.4 KB).
# CONFIG_MBEDTLS_PEM_PARSE_C is not set
# CONFIG_MBEDTLS_PK_PARSE_EC_EXTENDED is not set
# CONFIG_MBEDTLS_PK_PARSE_EC_COMPRESSED is not set
# Precomputed base-point comb tables in flash for P-256 / P-384:
# −0.45…0.6 s per full TLS handshake (each ECDSA verify does a
# fixed-point u1·G; the ECDHE itself is X25519, a Montgomery ladder the
# tables don't apply to; two handshakes per boot plus every reconnect)
# for +5.6 KB flash (round 1.3.1).
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS=n
# Tinylink never calls mbedtls_strerror() — error reporting goes through
# ESP_LOG with the hex error code only. Dropping the string lookup saves
# the ~8 KiB table that maps each MBEDTLS_ERR_* enum to its human name.
# Field-debug an mbedtls error by grepping include/mbedtls/error.h with
# the printed hex value.
# CONFIG_MBEDTLS_ERROR_STRINGS is not set

# ---- mbedTLS ECP curves — trim to {P-256, P-384, Curve25519} ----------------
# Tailscale's controlplane.tailscale.com chain, re-verified 2026-10-28 via
#   openssl s_client -connect controlplane.tailscale.com:443 \
#     -servername controlplane.tailscale.com -showcerts
#
# Leaf cert:  public key = P-256 (prime256v1),
#             signed with ecdsa-with-SHA384 by "Let's Encrypt YE1"
# YE1:        P-384, signed with ecdsa-with-SHA384 by "ISRG Root YE"
# Root YE:    P-384, signed with ecdsa-with-SHA384 by ISRG Root X2
# X2:         P-384, served cross-signed by ISRG Root X1 (RSA)
# (2026-05-12 it was leaf → E8 → X2; same key types.)
#
# So we MUST keep P-256 (leaf key) AND P-384 (intermediate + root key) to
# validate the chain, and RSA for the X1 cross-sign. Hash side is covered
# by CONFIG_MBEDTLS_SHA512_C=y (provides SHA-384). DERP TLS endpoints
# (derp16b.tailscale.com etc.) use the sibling YE2 under the same Root
# YE, so this set serves both.
#
# Initial attempt on this branch trimmed P-384 too, which broke the
# handshake with mbedtls_ssl_handshake = -0x3A00 (X509_CERT_VERIFY_FAILED)
# against BOTH controlplane and derp1 — fail-loud at boot, no silent
# regression. P-384 stays on. Re-audit if Tailscale ever rotates to a
# different LE chain (E5/E6 are P-256, but the upstream root behind those
# is still P-384 ISRG X2 today).
#
# Curve25519 stays on too, and it is not a hedge: mbedTLS offers x25519
# first in supported_groups and both controlplane and DERP pick it, so
# every TLS 1.2 handshake's ECDHE is mbedTLS X25519 (openssl s_client
# "Peer Temp Key: X25519", 2026-10-28); without it the ECDHE falls back
# to P-256. Noise IK + WireGuard use the vendored X25519 in
# crypto/curve25519*.c independently of this Kconfig.
#
# Dropped curves (8): SECP192R1, SECP224R1, SECP521R1, the three Koblitz
# (SECP192K1, SECP224K1, SECP256K1), and the three Brainpool (BP256R1,
# BP384R1, BP512R1). Confirmed pre-trim via xtensa-esp32-elf-nm that
# these consumed `ecp_mod_p<bits>` helpers (~78-610 B each) plus per-
# curve `<curve>_p/_n/_gx/_gy/_b/_a` rodata tables (48-68 B × 6 per
# curve) ≈ 5-7 KiB across all eight.
# CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED is not set

# ---- mbedTLS — final prune: CCM, PKCS7, non-AES GCM, deterministic ECDSA ----
# Final stage of the perf-audit mbedTLS section (stages 1-3 trimmed
# curves, static-ECDH, and X.509 CRL/CSR). This batch turns off four
# more sub-systems that grep confirms tinylink and its dependencies
# never call.
#
# 1. CCM_C — AES-CCM mode (counter with CBC-MAC, RFC 3610). Used by
#    some IoT-class TLS suites (TLS_*_WITH_AES_*_CCM_8 etc.) and by
#    DTLS deployments that want a lighter alternative to GCM. Modern
#    Go crypto/tls (controlplane + DERP) advertises ONLY GCM and
#    ChaCha20-Poly1305 — no CCM in the suite list. Verified empirically
#    for an AES-first offer: ECDHE-ECDSA-AES128-GCM-SHA256 (P-256 leaf
#    keys; this note used to say ECDHE-RSA). Since 1.3.2 that is what
#    the firmware negotiates — ChaCha20-Poly1305 is no longer compiled
#    into mbedTLS (see the CHACHA lines at the top of this section).
#
# 2. PKCS7_C — Cryptographic Message Syntax (PKCS#7 / RFC 2315) parser.
#    Used for S/MIME, code-signing envelopes, etc. The IDF bootloader's
#    secure-boot signature path uses ECDSA over the partition table +
#    app image, NOT PKCS#7. The tinylink TLS path uses raw X.509 certs,
#    not PKCS#7-wrapped chains. Grep: no `mbedtls_pkcs7_` calls
#    anywhere in components/tinylink/src or main/.
#
# 3. GCM_SUPPORT_NON_AES_CIPHER — gates ARIA-GCM + Camellia-GCM. Both
#    are Korean/Japanese alternatives to AES that nobody on the public
#    internet uses for TLS. xtensa-esp32-elf-nm on the pre-trim ELF
#    shows the ARIA implementation present:
#      mbedtls_aria_setkey_enc  (883 B .text)
#      mbedtls_aria_crypt_ecb   (814 B .text)
#      aria_sb1/sb2/is1/is2     (256 B each rodata, 1024 B total)
#      mbedtls_aria_crypt_cbc / _cfb128 / setkey_dec
#    plus the ARIA-specific GCM wrapper. Disabling this Kconfig drops
#    only the non-AES GCM wrappers. Camellia is gone (esp_config.h
#    #undefs MBEDTLS_CAMELLIA_C unless CONFIG_MBEDTLS_CAMELLIA_C), but
#    MBEDTLS_ARIA_C comes from upstream mbedtls_config.h, which IDF does
#    not override, and cipher_wrap.c still linked mbedtls_aria_*
#    (re-checked 2026-10-28 in the 1.3.0 map). Since round 1.3.2
#    mbedtls_user_config.h (MBEDTLS_USER_CONFIG_FILE, top-level
#    CMakeLists.txt) #undefs MBEDTLS_ARIA_C.
#
# 4. ECDSA_DETERMINISTIC — RFC 6979 deterministic-nonce ECDSA SIGNING.
#    Tinylink only VERIFIES ECDSA signatures (the Tailscale cert chain
#    + the optional control-key TOFU pin). Verification uses
#    mbedtls_ecdsa_verify, which doesn't depend on nonce generation at
#    all — the signature already carries the (r, s) pair. The
#    deterministic-sign API + its HMAC_DRBG backing (~600 B
#    mbedtls_hmac_drbg_*) are pure dead weight here.
#
# What stays enabled:
#   MBEDTLS_GCM_C=y            (AES-GCM, the suite Tailscale uses;
#                               the only AEAD suite left since 1.3.2)
#   MBEDTLS_ECDSA_C=y          (verify-only path)
#   MBEDTLS_X509_CRT_PARSE_C=y (still load-bearing for cert chain)
#
# Expected symbol drop: full ARIA (~3-4 KiB), CCM mode functions
# (~1-1.5 KiB), HMAC_DRBG (~600-800 B), deterministic-ECDSA signing
# helpers (~200 B). All four batched into one PR because they have
# zero coupling to each other; each one's verify-path effect is
# independently grep-verified above.
# CONFIG_MBEDTLS_CCM_C is not set
# CONFIG_MBEDTLS_PKCS7_C is not set
# CONFIG_MBEDTLS_GCM_SUPPORT_NON_AES_CIPHER is not set
# CONFIG_MBEDTLS_ECDSA_DETERMINISTIC is not set

# ---- mbedTLS — drop X.509 CRL + CSR parsers (unused by tinylink) ------------
# CRL_PARSE_C: Certificate Revocation List parser. mbedTLS's
# x509_crt_verifycrl is the only consumer in the verify path, and
# esp_tls invokes mbedtls_x509_crt_verify_with_profile passing NULL for
# `ca_crl` (esp-tls/esp_tls_mbedtls.c: no CRL argument is constructed
# anywhere). controlplane.tailscale.com publishes OCSP responses, not
# CRLs — Let's Encrypt deprecated CRL distribution points for end-entity
# certs years ago and runs OCSP via ocsp.int-x3.letsencrypt.org. We
# don't do OCSP stapling either; revocation checking on this device is
# best-effort via fresh handshakes and the rotation cadence the cert
# bundle ships with. The verify path stays correct: untrusted leaf
# certs are still rejected via signature + chain + expiry checks,
# only the "is this cert on a revocation list" probe goes away —
# which was a no-op already.
#
# CSR_PARSE_C: Certificate Signing Request parser. Tinylink never
# generates or parses CSRs — `keys.c`, `control_key.c`, and
# `noise_ik.c` produce raw key material (Curve25519 + ECDSA-P256)
# without an enrolment / X509 path. esp_tls doesn't parse CSRs either
# (it's a client TLS lib, not a CA). Pure dead code.
#
# Symbol impact (pre-trim ELF via xtensa-esp32-elf-nm): x509_crt_verifycrl
# (233 B static helper) + x509_get_crl_extensions / x509_get_crl_entry_ext
# / mbedtls_x509_crl_* full parser. mbedtls_x509_csr_parse* parser
# already gc-section-stripped by the linker (no caller). Verify-path
# integration #ifdef'd via MBEDTLS_X509_CRL_PARSE_C in
# mbedtls/library/x509_crt.c.
# CONFIG_MBEDTLS_X509_CRL_PARSE_C is not set
# CONFIG_MBEDTLS_X509_CSR_PARSE_C is not set

# ---- mbedTLS — drop static-ECDH key exchanges (TLS_ECDH_* suites) -----------
# ECDH_ECDSA / ECDH_RSA are static-ECDH cipher suites where the server's
# long-term ECDH public key sits in its cert (RFC 4492 §2.1, §2.3). They
# pre-date forward-secret handshakes; Go's crypto/tls server (which
# controlplane.tailscale.com and the DERP fleet run) never advertises
# them — the supported list is constrained to TLS_ECDHE_* (ephemeral)
# + TLS_RSA_* fallback (see go/src/crypto/tls/cipher_suites.go).
#
# The handshake picks ECDHE-ECDSA-AES128-GCM-SHA256 (P-256 leaf keys;
# the Stage-1 note said ECDHE-RSA). Dropping static-ECDH does not narrow
# our viable suite set — those suites were dead negotiation surface only.
#
# ECDHE_RSA + ECDHE_ECDSA stay on (those are what Tailscale actually
# negotiates). Plain-RSA key exchange is off since the client-only TLS
# block above (2026-09); RSA itself stays for signature checks (ISRG
# Root X1 signs the X2 cross-certificate).
#
# Symbol impact (xtensa-esp32-elf-nm, pre-trim ELF): `ssl_pick_cert`
# (124 B) does static-ECDH cert-key-type selection only; ssl_parse_*
# branches that handle the static-ECDH server-cert-as-keystore path;
# the static-ECDH entries in the cipher suite table. Shared mbedtls_
# ecdh_* helpers stay (also used by ECDHE).
# CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA is not set
# CONFIG_MBEDTLS_KEY_EXCHANGE_ECDH_RSA is not set

# ---- lwIP tunings ------------------------------------------------------------
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
# No ARP probe of the offered address: LWIP_DHCP_CHECKS_OFFERED_ADDRESS
# is a choice, so the old `CONFIG_LWIP_DHCP_DOES_ARP_CHECK=n` here was
# ignored and the default ARP check (2 × 500 ms probes, acd_dhcp_check.c)
# ran on every boot and re-association. Selecting the member is what
# turns it off (round 1.3.1, −0.5…1.0 s per DHCP bind). The AP's DHCP
# server is the only allocator on the sensor's LAN.
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y
CONFIG_LWIP_TCP_SACK_OUT=n
CONFIG_LWIP_TCP_MSS=1440
# Pin lwIP tcpip_thread to CPU0 (same core as WiFi MAC) for cache
# locality with the WiFi driver's RX path. IDF default is NO_AFFINITY,
# which lets the scheduler bounce the task between cores under load
# and incurs cache misses on every move. tinylink's throughput isn't
# WiFi-bound, but the change is free (one Kconfig) and removes a
# small jitter source. WiFi task itself is pinned to CPU0 via
# CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y (already set).
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# Trim socket descriptor pool. tinylink concurrent socket budget:
#   1× UDP for STUN probe (stun_probe.c:136)
#   1× UDP for telemetry (telemetry.c:47)
#   1× UDP for WG transport (wg_netif.c:1042)
#   1-2× TCP for esp_tls to controlplane (long-poll + register cycle)
#   1× TCP for esp_tls to derp*.tailscale.com (supervisor)
# = 5-6 concurrent max. 6 gives one spare; failure mode is EAGAIN
# on socket() which would be visible immediately in serial. IDF
# default of 10 wastes ~250 B per unused slot in lwip_socket_t.
CONFIG_LWIP_MAX_SOCKETS=6
# lwIP loopback (127.0.0.1) — unused. Tinylink talks to localhost
# nowhere; the 100.64.0.0/10 CGNAT range is routed via the WG netif,
# the 192.168.x.x AP subnet via WiFi, and the WAN via the default
# WiFi route. No code path constructs a sockaddr_in with INADDR_LOOPBACK.
# Disabling drops the loopback pbuf pool (8 × ~80 B ≈ 640 B BSS) plus
# the netif_loop integration code. esp_netif still works without it.
# CONFIG_LWIP_NETIF_LOOPBACK is not set
# DNS resolution path stays via the regular WiFi netif's DNS list
# (set via DHCP from INTELCOM-CARDONA). mDNS query support is unused
# — tinylink resolves controlplane.tailscale.com / derp*.tailscale.com
# via standard DNS, never via mdns. The IDF mdns component is also
# excluded by EXCLUDE_COMPONENTS in CMakeLists.txt, but the lwIP-side
# mDNS query parser is a separate Kconfig that stays on by default.
# CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES is not set
# DHCP server. CONFIG_ESP_WIFI_SOFTAP_SUPPORT is already off (we never
# start an AP interface) so there are no DHCP clients to serve. The
# dhcps_* code path is unreachable; disabling drops the module + the
# default lease table.
# CONFIG_LWIP_DHCPS is not set
# IPv4-only build: every socket in the firmware (WG UDP, esp_tls to
# controlplane.tailscale.com, DERP, STUN, telemetry) uses AF_INET. Disabling
# IPv6 recovers ~7 KiB RAM + ~39 KiB flash and shrinks the dual-stack
# attack surface.
CONFIG_LWIP_IPV6=n
# WireGuard sets its tunnel MTU to fit inside the outer UDP without IP
# fragmentation, and nothing on the outer side needs frag/reassembly.
# Reassembly is already off by IDF default; we pin both explicitly so
# regressions are caught at config-time. Removes a classic teardrop /
# overlap DoS surface on inbound packets. Safe because all outbound
# paths (WG UDP, TLS) fit under the link MTU.
CONFIG_LWIP_IP4_FRAG=n
CONFIG_LWIP_IP4_REASSEMBLY=n

# PPP support disabled — the WG tunnel netif now uses a custom no-op
# netstack defined in wg_lwip.c::s_wg_netstack_config (lines 178-184),
# landed in commit 4a915df ("feat/wg-netif-without-is-ppp"). Pre-Build-C
# we needed ESP_NETIF_NETSTACK_DEFAULT_PPP as the base template (forcing
# CONFIG_LWIP_PPP_SUPPORT=y), but the custom netstack now provides the
# raw-IP init_fn + stub input_fn directly without depending on the PPP
# module. Turning PPP off recovers ~10-20 KiB flash (ipcp_nakci,
# vj_compress_tcp, ppp_pcb, LCP/PAP/CHAP FSM, HDLC framing — all
# verified inalcanzables in the post-4a915df build via xtensa-esp32-elf-nm).
# CONFIG_LWIP_PPP_SUPPORT is not set

# ---- VFS trim ----------------------------------------------------------------
# Tinylink doesn't open files (no SD/SPIFFS/FAT), doesn't iterate
# directories (no readdir/opendir), and doesn't talk to the console
# beyond raw `printf` via UART. Keeping SELECT on because lwIP's user
# code may call select() on sockets; keeping IO on because newlib stdout
# routes through it.
# CONFIG_VFS_SUPPORT_TERMIOS is not set
# CONFIG_VFS_SUPPORT_DIR is not set

# ---- NVS encryption ----------------------------------------------------------
# Deliberately OFF (owner decision 2026-07-16, docs/ROADMAP.md "Execution
# queue"): NVS/flash encryption needs irreversible eFuse burns, which the
# project declines. The `CONFIG_NVS_ENCRYPTION=y` that used to sit here was
# inert anyway — on the ESP32 it depends on CONFIG_SECURE_FLASH_ENC_ENABLED,
# which is off, so Kconfig silently dropped it from the generated sdkconfig
# while docs/tooling kept describing NVS as encrypted. Keys are plaintext on
# flash; physical-access attackers are out of scope (docs/SECURITY-MODEL.md).
# CONFIG_NVS_ENCRYPTION is not set

# ---- Logging -----------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Log V2 (round 1.3.1): the "I (ms) tag: " prefix and colour codes are
# formatted once in esp_log instead of being baked into every format
# string (−19 KB flash with colours off, +1.9 KB IRAM). Output text is
# unchanged apart from the missing ANSI colour escapes, so soak greps
# keep working. V2 costs a little more stack per log call — the
# stack-diag dump is the check (tinylink_tlm / wifi run closest).
CONFIG_LOG_VERSION_2=y
# CONFIG_LOG_COLORS is not set
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y
# Static log levels: nothing calls esp_log_level_set(), so the per-tag
# cache + linked list and the runtime level check go (round 1.3.1).
CONFIG_LOG_TAG_LEVEL_IMPL_NONE=y
# CONFIG_LOG_DYNAMIC_LEVEL_CONTROL is not set
# Console UART at 500 000 (round 1.3.1). The console has no UART driver,
# so every log line busy-waits on the 128-B TX FIFO — at 115 200 the
# 15-line stack-diag dump spun ≈ 85 ms per minute. Why 500 000 and not
# 921 600: with PM_ENABLE the console runs from REF_TICK (1 MHz,
# esp_pm/pm_impl.c:977) so IDF caps it at 1 Mbaud, and 921 600 comes out
# ≈ 941 k (+2.1 %); 500 000 divides 1 MHz exactly. The rate is only
# settable on the CUSTOM console choice (same UART0, GPIO1/GPIO3).
# `idf.py monitor` picks the rate up from this option; CH340 does it
# exactly (12 MHz / 24). The ROM loader's first lines stay at 115 200
# (garbled at this rate; the 2nd-stage bootloader is silent anyway, see
# below) — the app prints the reset reason itself at boot.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=500000
# Production bootloader: no UART chatter (`ets Jul 29 2019…`, partition
# table dump, `boot:` lines, `esp_image:` segments). The bootloader
# still runs the same code; only the log prints are compiled out via
# Kconfig. Recovery on a stuck boot is still possible by re-flashing
# with a "diag" overlay that flips this back to INFO. Saves ~3 KiB in
# the bootloader binary slot (no impact on app slot).
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# ---- FreeRTOS ----------------------------------------------------------------
# HZ=100 (10 ms tick granularity) reduces tick-ISR overhead vs the IDF
# default 1000 (1 ms ticks) and lets tickless idle skip larger blocks
# at once. Audited 2026-05-10: every pdMS_TO_TICKS(N) callsite in tinylink
# uses N >= 100 ms, so no delay round-trips to 0 ticks. No bare integer
# tick arguments to vTaskDelay / xQueue* / xSemaphoreTake in our code.
CONFIG_FREERTOS_HZ=100
# No FreeRTOS software timers (round 1.3.1): every timer in the
# firmware is an esp_timer (app_wifi reconnect, STUN re-probe retry)
# and neither IDF nor the Wi-Fi blobs create xTimers, so the "Tmr Svc"
# task (stack + TCB + queue) goes (−1.3 KB flash, −2.5 KB heap). The
# old TIMER_TASK_AFFINITY_CPU0 pin went with it.
# CONFIG_FREERTOS_USE_TIMERS is not set

# ---- lwIP tcpip_thread stack — bump from IDF default 3 KiB ------------------
# 30-min soak 2026-05-13 caught a stack overflow in the `tiT` task
# (the lwIP tcpip_thread) under heap-pressure conditions: Servidor1's
# WG responder was unreachable for several minutes, ESP32-side
# handshake retries piled up, telemetry sendto started returning ENOMEM
# (errno=12) on the UDP socket — lwIP's error-recovery path in tcpip_
# input/tcpip_callback used more stack than the happy path, and at the
# default 3 KiB allocation `tiT` was already at 95.5 % steady-state
# (`hwm = 140 B free` consistent across the soak's diag dumps).
# Result: explicit FreeRTOS stack-overflow canary fire + reset.
#
#   Panic signature:  ***ERROR*** A stack overflow in task tiT has
#                     been detected.
#   Steady-state peak: 2 932 B used out of 3 072 alloc
#   Crash scenario:   deeper code path under ENOMEM / heap-fragment-
#                     ation conditions, exact peak unknown but > 3 072 B
#
# 4 608 B (4.5 KiB) gives 1 676 B margin (57 %) over the observed
# steady-state peak. That's the cushion size adopted as a baseline for
# the stack trims in this round; same target works in reverse for
# bumping a too-tight stack. Cost: ~1.5 KiB more heap at lwIP init —
# acceptable trade vs the device-resets-itself-in-the-field failure
# mode.
#
# Not bumping to 5 KiB or 6 KiB because the underlying cause (heap
# pressure from extended WG-responder-unreachable cascade) is fixable
# upstream — once Servidor1 stays reachable, the deep path doesn't fire.
# 4.5 KiB is sized for the rare residual scenario where Servidor1 burps
# briefly.
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4608
# TRACE_FACILITY backs uxTaskGetSystemState() (the stack-diag dump).
# Run-time stats are off (round 1.3.1): nothing reads the per-task CPU
# counters, and keeping them meant an esp_timer read on every context
# switch.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
# CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS is not set

# ---- IRAM-to-flash placement (production trim) -------------------------------
# ESP32-WROOM-32E has only 128 KiB IRAM total; the post-η firmware was
# at 80% IRAM (104 KiB used, 27 KiB free). These three knobs move
# never-from-ISR code paths out of IRAM and into flash-XIP. Real-time
# behaviour is unchanged because none of these functions are reachable
# while flash is suspended (auto-suspend disabled in tinylink) or from
# cache-disabled ISRs (we have no such ISR). Documented cost: WiFi
# RX throughput drops a few percent because every RX packet now incurs
# a flash cache miss on its first call. Tinylink's load (1 Hz
# telemetry + ~6/min long-poll inbound + WG handshake every ~85 s) is
# 3 orders of magnitude below the WiFi ceiling, so the throughput
# hit is invisible.

# WiFi RX path: the biggest single IRAM mover (~15 KiB).
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# FreeRTOS scheduler hot path: moves vTaskSwitchContext / xQueue*
# helpers / xSemaphore* into flash. Safe because we never call them
# from a cache-disabled ISR.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
# RingBuffer helpers: tinylink doesn't have an ISR producer/consumer
# for any RingBuffer.
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
# newlib lock helpers (`__retarget_lock_*`): only need to be in IRAM
# if newlib state is mutated from a cache-disabled ISR, which tinylink
# does not do (no SPI_FLASH_AUTO_SUSPEND, no IRAM_ATTR newlib touch).
# CONFIG_LIBC_LOCKS_PLACE_IN_IRAM is not set

# ---- TLS to control plane ----------------------------------------------------
# tinylink talks ts2021 over TLS to controlplane.tailscale.com. We use
# esp_tls on top of mbedtls and verify against the IDF certificate bundle.
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_ESP_TLS_USE_SECURE_ELEMENT=n
CONFIG_ESP_TLS_INSECURE=n
# CONFIG_MBEDTLS_POLY1305_C is not set
# nghttp2_session_recv() reads into a stack buffer of this size. 512
# instead of 4096 (round 1.3.1): h2_client.c's recv_cb serves it from
# the already-decrypted Noise record (conn->h2_rx), and session_recv
# loops until WOULDBLOCK, so a smaller buffer only means more memcpy
# calls per record — the frame of nghttp2_session_recv drops 4 128 →
# 544 B on the long-poll stack.
CONFIG_ESP_NGHTTP2_INBOUND_BUFFER_LENGTH=512

# ---- App task stacks ---------------------------------------------------------
# Bigger main stack: TLS + Noise IK + JSON construction is much heavier than
# the M1-WG bringup that this replaces. Verified on-device 2026-05-02:
# the boot-time mbedtls cert-chain verification + ECDSA + Noise IK init
# in tinylink_register peaks at ~14 KiB; bumped from 16 K to 24 K to give
# margin. The long-poll task in tinylink.c::tinylink_long_poll_start
# also xTaskCreate's at 24 KiB to absorb the same workload — bug from
# 8 K manifested as random LoadProhibited / Double exception / fake
# heap-corruption asserts.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576

# esp_timer dispatch task stack. mbedtls / lwIP timer callbacks (e.g.
# session ticket lifetime, sntp, peer-cert cleanup) routed through here
# blow past the 3584-byte default once TLS to controlplane.tailscale.com
# is up. Observed on first HW boot 2026-05-02: panic with EXCCAUSE 0x1c
# (LoadStoreError) immediately after the control-key fetch path,
# classic stack-overflow corruption. 6144 gave ~2x headroom. Round 1.3.3
# (B18): tools/stack_worst.py puts the static worst case at 3 248 B (a
# Wi-Fi blob timer → pm chain → an unresolved blob call bounded by the
# whole Wi-Fi OS adapter → nvs_open → flash read → log); 1 580 B measured
# over the 6-h 1.3.2 soak. 4608 = 1.3 KB over the static worst case.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4608

# ---- Production: silent error paths ------------------------------------------
# newlib-nano printf/scanf — drops %lld/%llu/%lf support, recovers the
# big chunk of flash that _vfprintf_r / _svfprintf_r / __ssvfscanf_r
# carry (measured ~11 KiB / 11 KiB / 8.6 KiB pre-trim in the post-curves
# ELF, plus _strtod_l + _dtoa_r at ~3 KiB each). Enabled together with
# the conversion of all 11 %lld/%llu call-sites in this branch to
# either (unsigned long)+%lu (for bounded counters) or 32-bit hex high/
# low split (for genuine 64-bit values: TAI64N timestamps, Tailscale
# node ID). Float formatting is not the issue: IDF's newlib_init.c
# registers _printf_float even under nano, so %f would work — tinylink
# just never logs floats (telemetry prints temp as %ld.%03ld manually).
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y
# Global -Os (round 1.3.1; IDF default is -Og). −62 KB flash, −6.6 KB
# IRAM, and still faster than -Og everywhere. The hot paths stay -O2 as
# per-source islands (round 1.3.2, B6): in tinylink the crypto, WG data
# plane + handshake, DISCO, DERP, keys and TMP117 files
# (components/tinylink/CMakeLists.txt); in mbedcrypto bignum /
# bignum_core / ecp / ecp_curves, the MPI glue and the AES-GCM record
# path, plus lwIP's checksum / pbuf / UDP / IPv4 and FreeRTOS queue.c
# (top-level CMakeLists.txt); main/ stays -O2 as a whole.
# -Os also drops FreeRTOS's task-function wrapper (it needs -Og): a task
# body that returns crashes at PC=0 instead of aborting with "should not
# return". No tinylink task returns (all six checked 2026-10-28) — keep
# it that way; tasks end with vTaskDelete(NULL).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Asserts still abort (level=1) but don't print the message string + __FILE__
# + __LINE__. Same crash safety, ~10 KiB flash saved across the error-handling
# surface. Re-enable (=2) in a "diag" overlay if field-debugging a panic.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
# ESP_RETURN_ON_ERROR / ESP_GOTO_ON_ERROR drop their format-string parameter
# when CHECKS_SILENT=y. The check still triggers the goto/return; only the
# log line on error is elided.
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=y
# Drops the ~7 KiB esp_err_msg_table[] rodata; esp_err_to_name() returns
# "UNKNOWN ERROR" plus the hex code. Operationally readable, just lookup-free.
# CONFIG_ESP_ERR_TO_NAME_LOOKUP is not set

# ---- Task watchdog (2026-09) --------------------------------------------------
# Application tasks subscribe to the task WDT (CONFIG_TINYLINK_APP_TASK_WDT,
# tinylink core menu). 60 s — the Kconfig maximum (range 1..60; a larger
# value is silently dropped and the 5-s default comes back, which the
# telemetry task's 5-s period cannot satisfy — seen on hardware
# 2026-09-04) — covers the longest blocking primitive in the firmware:
# one 30-s SO_RCVTIMEO TLS poll plus reconnect work, with the tls_io poll
# hook feeding on every iteration. PANIC=y turns a wedged
# task into a reboot into the known-good boot path — the purpose of the
# subscription. Idle tasks stay subscribed (CPU-starvation detection).
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y

# ---- Wall clock for certificate validation (2026-09, tl_time.c) ------------
# SNTP is compiled anyway (lwIP); with HAVE_TIME_DATE the three TLS
# clients check notBefore/notAfter once the clock is NTP-synced. Until
# then tl_crt_bundle_attach() tolerates date flags (offline boots keep
# working) and the clock is floored to the build / last-synced time.
CONFIG_MBEDTLS_HAVE_TIME=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
