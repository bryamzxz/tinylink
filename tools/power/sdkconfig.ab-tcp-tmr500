# A/B (round 1.3.7): lwIP's TCP timer every 500 ms instead of 250. It runs
# as long as any TCP connection is open — the control and DERP conns
# always are — so it is 4 of the ~5 lwIP wakes per second. Delayed ACKs
# wait ≤ 500 ms; retransmission timers count in 1-s slow ticks, so the
# initial RTO (LWIP_TCP_RTO_TIME / slow tick) is set to 2 ticks = 1–2 s
# (250 ms + 1 500 ms: 3 ticks = 1.0–1.5 s).
CONFIG_LWIP_TCP_TMR_INTERVAL=500
CONFIG_LWIP_TCP_RTO_TIME=2000
