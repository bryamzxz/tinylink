# A/B (round 1.3.7): Wi-Fi TX power capped at 13 dBm (IDF default 20; the
# PHY init data then caps every rate's target at 52 quarter-dBm,
# esp_phy/esp32/phy_init_data.c). The sensor hears the AP at −52 dBm; with
# a symmetric path and an AP near 20 dBm the AP would hear the sensor at
# about −59 dBm, 13 dB above MCS7's −72 dBm (MOD Table 21). Average
# current barely moves (the radio transmits < 0.1 % of the time); TX
# peaks drop (MOD Table 16: 379 mA peak for 11b at 19.5 dBm, 258 mA for
# MCS7 at 13 dBm — current against configured power is not in the docs).
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=13
