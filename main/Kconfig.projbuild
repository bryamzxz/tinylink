menu "tinylink application"

    config TINYLINK_DEVICE_HOSTNAME
        string "Device hostname"
        default "sensor-cali"
        help
            Hostname advertised to DHCP, used as the Tailscale node hostname
            (Hostinfo.Hostname) and surfaced in the admin panel.

    config TINYLINK_CONTROL_HOST
        string "Control plane host"
        default "controlplane.tailscale.com"
        help
            Tailscale control plane hostname. Override only for testing
            against a self-hosted Headscale.

    config TINYLINK_CONTROL_PORT
        int "Control plane TCP port"
        default 443
        range 1 65535

    choice TINYLINK_CONTROL_PROFILE
        prompt "Control-plane key bootstrap profile"
        default TINYLINK_CONTROL_PROFILE_CUSTOM
        help
            How the compile-in fallback control pubkey
            (CONFIG_TINYLINK_CONTROL_PUB_FALLBACK_HEX below) is
            sourced:

              * "Custom / development" leaves it empty by default. The
                first boot does TOFU via GET /key?v=100 — convenient for
                Headscale / development but exposes a one-shot MITM
                window during that fetch.

              * "Official / production" requires the operator to fill
                CONFIG_TINYLINK_CONTROL_PUB_FALLBACK_HEX in a
                sdkconfig.defaults overlay (see
                sdkconfig.defaults.prod.example) with the published
                control plane key. control_key.c then installs the pin
                without ever contacting the network, closing the TOFU
                window entirely. control_key_refresh() additionally
                rejects any later-fetched key that disagrees with this
                value, so rotation attempts cannot silently downgrade.

        config TINYLINK_CONTROL_PROFILE_CUSTOM
            bool "Custom / development (allow first-boot TOFU)"

        config TINYLINK_CONTROL_PROFILE_OFFICIAL
            bool "Official / production (require compile-in pubkey)"

    endchoice

    config TINYLINK_CONTROL_PUB_FALLBACK_HEX
        string "Compile-in fallback control plane pubkey (64 hex chars, empty = TOFU)"
        default ""
        help
            If non-empty, must be exactly 64 hex chars representing the
            32-byte Curve25519 public key of the control plane the
            device should trust. On first boot (NVS namespace tl_pin
            empty), the device installs this fallback as the pin
            without contacting the network — eliminating the TOFU
            window where a MITM during the initial GET /key?v=100
            could substitute the pin. control_key_refresh() also
            refuses any fetched key that disagrees with this value, so
            the protection survives later rotation attempts. Leave
            empty to keep the legacy first-boot TOFU behavior (suitable
            for development; for production use ship the operator's
            known control pubkey here).

            When TINYLINK_CONTROL_PROFILE_OFFICIAL is selected, a
            BUILD-time assertion in control_key.c rejects an empty
            value to prevent shipping production firmware that still
            does TOFU. Use sdkconfig.defaults.prod.example as a
            template.

    config TINYLINK_REGISTER_RETRY_MS
        int "Retry interval after MachineAuthorized=false (ms)"
        default 30000
        range 1000 600000
        help
            How long to wait between retries when the control plane reports
            MachineAuthorized=false (e.g. waiting for the operator to approve
            the node in the admin panel).

    config TINYLINK_STREAM_IDLE_TIMEOUT_S
        int "Control/DERP stream idle timeout (s)"
        default 120
        range 60 3600
        help
            Maximum continuous silence tolerated on the control-plane
            long-poll and the supervised DERP stream before the
            connection is declared dead and re-established. The control
            plane emits a KeepAlive on the map stream every ~60 s and
            DERP relays keepalive at a similar cadence, so the default
            (120 s — mirroring the upstream client's watchdogTimeout in
            control/controlclient/direct.go) means two missed
            KeepAlives. This is what converts a half-open TCP
            connection (control instance replaced without FIN/RST,
            expired NAT flow) from a permanent hang into a normal
            reconnect. Internally rounded up to a whole number of 30-s
            socket-timeout polls.

    config TINYLINK_CONTROL_WEDGE_RESTART_S
        int "Restart if control plane is unreachable this long (s, 0 = off)"
        default 3600
        range 0 86400
        help
            Last-resort self-heal: if the long-poll task has not seen a
            single byte from the control plane for this long — despite
            its bounded per-connection timeouts and reconnect backoff —
            dump task diagnostics and esp_restart(). This covers wedge
            classes that per-connection timeouts cannot reach:
            persistent heap fragmentation starving new TLS handshakes,
            lwIP/DNS wedges, or control-side node-state loss that a
            fresh boot (register + map) recovers from.

            The WireGuard data plane can outlive a control outage, so
            the default is deliberately long (60 min) to avoid
            restarting a device whose telemetry still flows during a
            pure control-plane outage.

            When enabled, a failed bringup (e.g. WiFi absent at boot)
            also restarts after 60 s instead of parking in diagnostics
            mode forever. Set to 0 to disable both behaviors and keep
            the stay-up-for-diagnostics semantics.

    config TINYLINK_STUN_HOST
        string "STUN server hostname (M4)"
        default "stun.l.google.com"
        help
            STUN server queried at boot to discover the device's public
            AddrPort. The result is uploaded to the Tailscale control
            plane via Hostinfo.Endpoints so peers learn an address they
            can try to dial directly. Failure is non-fatal — the rest
            of the stack stays up exactly like the pre-M4 baseline.

    config TINYLINK_STUN_PORT
        int "STUN server UDP port (M4)"
        default 19302
        range 1 65535

    config TINYLINK_DERP_SMOKE_HOST
        string "DERP fallback hostname (before the first netmap)"
        default "derp16b.tailscale.com"
        help
            Relay the DERP supervisor dials if the first netmap has not
            arrived within its 30-s wait (and the host used by the
            SUPERVISED=n boot smoke). Keep it in the same region as
            TINYLINK_PREFERRED_DERP — the netmap-driven host replaces
            it as soon as the DERPMap is parsed, but until then peers
            relay to us through the preferred region, so a fallback in
            another region (the old default was derp1, region 1) leaves
            relayed DISCO/CallMeMaybe unreachable. Set to empty to skip
            the SUPERVISED=n smoke entirely.

    config TINYLINK_PREFERRED_DERP
        int "Preferred DERP region ID advertised in MapRequest"
        default 16
        range 0 65535
        help
            Tailscale region ID we tell the control plane is our home
            DERP. Peers use this to pick which relay to send packets
            through when they can't reach us directly. Region 16 is
            mia (Miami) — closest to most South American deployments.
            Set to 0 to omit the field entirely (server treats as
            "client has no preference").

    config TINYLINK_DERP_SUPERVISED
        bool "Run a supervised DERP recv-loop task"
        default y
        help
            Establish a persistent DERP conn and run derp_client_run()
            in a dedicated FreeRTOS task: read frames, auto-answer
            DISCO Pings (so `tailscale ping <us>` from a remote peer
            responds via relay), log received packets, reconnect on
            stream end.

            The task body is resilient — initial connect runs inside
            its own backoff loop, so a transient low-largest-block
            window doesn't permanently disable the supervisor.

            Heap budget verified on-device 2026-05-06 after BSS
            shrink (jsmn token table 3920→2500): largest contiguous
            block at supervisor-spawn ≈ 21.5 KiB, mbedtls cert chain
            verify peak ~12 KiB → supervisor connects on attempt #1.
            8-minute steady-state run: 0 panics, 0 stream ends, 0
            supervisor reconnects, telemetry uninterrupted, parser
            still under token budget.

            Set to n only if a target derivation needs to drop DERP
            entirely (e.g. extreme memory-bound sensor build with
            no DERP relay path).

    config TINYLINK_DERP_SUPERVISED_BACKOFF_MS
        int "DERP supervised reconnect backoff base (ms)"
        depends on TINYLINK_DERP_SUPERVISED
        default 15000
        range 1000 600000
        help
            Initial sleep between a stream end / connect failure and
            the next connect attempt. The supervisor doubles this value
            on every consecutive connect failure up to a hardcoded 30 s
            cap, and resets it back to this base on successful login.
            Mirrors the long-poll's TINYLINK_REGISTER_RETRY_MS shape —
            small enough to recover quickly, large enough to avoid
            hammering the server when it's down for an extended window.

    config TINYLINK_STUN_REPROBE_MS
        int "STUN re-probe cadence (ms, M4)"
        default 300000
        range 30000 3600000
        help
            How often to re-run the STUN binding probe after the boot-time
            probe. NATs periodically rebind external ports (especially
            after idle) and residential WAN IPs can change without the
            device noticing. The default 300 s (5 min) matches the natural
            cadence of Tailscale long-poll reconnects so the freshest
            endpoint is in HostInfo when the next /machine/map fires.

    menu "Telemetry (M3)"

        config TINYLINK_TELEMETRY_ENABLE
            bool "Enable TMP117 telemetry task"
            default y
            help
                Spawn a FreeRTOS task that reads the TMP117 over I²C and
                pushes JSON samples over UDP to the home peer through the
                WireGuard netif. Disable for boards that ship without the
                sensor — the rest of the stack stays up.

        config TINYLINK_I2C_SDA_GPIO
            int "I²C SDA GPIO"
            depends on TINYLINK_TELEMETRY_ENABLE
            default 21
            range 0 39
            help
                Freenove ESP32-WROOM-32E DevKit default. Override for other
                boards.

        config TINYLINK_I2C_SCL_GPIO
            int "I²C SCL GPIO"
            depends on TINYLINK_TELEMETRY_ENABLE
            default 22
            range 0 39

        config TINYLINK_TMP117_I2C_ADDR
            hex "TMP117 7-bit I²C address"
            depends on TINYLINK_TELEMETRY_ENABLE
            default 0x48
            range 0x48 0x4B
            help
                The TMP117 supports addresses 0x48..0x4B selected by ADD0
                strapping. 0x48 is the default for ADD0 tied to GND.

        config TINYLINK_TELEMETRY_PERIOD_MS
            int "Telemetry sample period (ms)"
            depends on TINYLINK_TELEMETRY_ENABLE
            default 5000
            range 500 600000

        config TINYLINK_TELEMETRY_DEST
            string "Telemetry UDP destination (host:port)"
            depends on TINYLINK_TELEMETRY_ENABLE
            default "100.88.250.54:27821"
            help
                IP:port to send JSON samples to. The IP must be reachable
                through the WireGuard netif — typically the home peer's
                tailnet 100.x address. Override per deployment.

    endmenu

endmenu
